```html
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yarashamizmi? ❤️</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #ffe1e8, #fff7f8);
            overflow: hidden;
        }

        .card {
            width: 90%;
            max-width: 500px;
            padding: 45px 25px;
            background: white;
            border-radius: 25px;
            text-align: center;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
        }

        h1 {
            color: #333;
            font-size: 30px;
        }

        p {
            color: #777;
            font-size: 18px;
            line-height: 1.5;
        }

        .buttons {
            margin-top: 30px;
            min-height: 60px;
        }

        button {
            border: none;
            padding: 14px 28px;
            margin: 8px;
            border-radius: 12px;
            font-size: 18px;
            cursor: pointer;
        }

        #yes {
            background: #ff5c7a;
            color: white;
        }

        #no {
            background: #e5e5e5;
            color: #333;
            position: relative;
        }

        #result {
            display: none;
        }

        #result h2 {
            color: #ff5c7a;
            font-size: 30px;
        }
    </style>
</head>

<body>

    <div class="card">

        <div id="question">

            <h1>Men bilan yarashasizmi? ❤️</h1>

            <p>
                Hammasini ortda qoldirib,<br>
                yana yaxshi munosabatda bo‘lamizmi?
            </p>

            <div class="buttons">

                <button id="yes">
                    HA ❤️
                </button>

                <button id="no">
                    YO‘Q 😅
                </button>

            </div>

        </div>


        <div id="result">

            <h2>Yarashdik ❤️</h2>

            <p>
                Rahmat! 🥹<br>
                Endi xafa bo‘lish yo‘q.
            </p>

        </div>

    </div>


    <script>

        const noButton = document.getElementById("no");

        function moveNoButton() {

            const buttonWidth = noButton.offsetWidth;
            const buttonHeight = noButton.offsetHeight;

            const maxX = window.innerWidth - buttonWidth - 20;
            const maxY = window.innerHeight - buttonHeight - 20;

            const x = Math.random() * maxX;
            const y = Math.random() * maxY;

            noButton.style.position = "fixed";
            noButton.style.left = x + "px";
            noButton.style.top = y + "px";
        }


        // Kompyuterda sichqoncha yaqinlashganda qochadi
        noButton.addEventListener("mouseenter", function () {
            moveNoButton();
        });


        // Telefonda bosishga uringanda qochadi
        noButton.addEventListener("touchstart", function (event) {

            event.preventDefault();

            moveNoButton();

        });


        // Bosishga ulgurib qolsa ham qochadi
        noButton.addEventListener("click", function (event) {

            event.preventDefault();

            moveNoButton();

        });


        // HA bosilganda
        document.getElementById("yes").addEventListener("click", function () {

            document.getElementById("question").style.display = "none";

            document.getElementById("result").style.display = "block";

        });

    </script>

</body>
</html>
```
